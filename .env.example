# Local development provider. Set RAG_PROVIDER=aws to run against AWS services.
RAG_PROVIDER=local

# Local chat and embedding models
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_GUARDRAIL_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Local vector store
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=kubernetes_rag
QDRANT_API_KEY=

# AWS provider settings (required when RAG_PROVIDER=aws)
AWS_REGION=us-east-1
BEDROCK_CHAT_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_GUARDRAIL_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_EMBEDDING_DIMENSIONS=1024
OPENSEARCH_ENDPOINT=
OPENSEARCH_INDEX=kubernetes-rag
S3_BUCKET=
S3_DOCUMENT_PREFIX=documents

# Optional telemetry and cache (cache is disabled by default)
LOGFIRE_TOKEN=
USE_SEMANTIC_CACHE=false
REDIS_URL=redis://localhost:6379

# Streamlit-to-API URL
BACKEND_URL=http://localhost:8000
